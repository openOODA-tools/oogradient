// # oogradient Main Entry Point
//
// Logline: Applies smooth TrueColor color gradient interpolation across lines of text.
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, --test, --demo, or --mcp.
//   2. Resolve multi-stop gradient presets or custom dual-endpoint hex color bounds.
//   3. Interpolate discrete TrueColor transitions across input text characters.
//   4. Format and stream rendered ANSI sequences or structured JSON telemetry.

import "core/color_types.oo";
import "core/color_presets.oo";
import "core/interpolator.oo";
import "render/render_ansi.oo";
import "render/render_json.oo";
import "render/render_demo.oo";
import "ipc/cli_options.oo";
import "ipc/mcp_server.oo";
import "anchor.oo";

fn run_all_tests() -> Bool {
    if !verify_root_subsystem() {
        return false;
    }

    let t1_args: List[String] = list_push(list_push(list_new(), "-p"), "sunset");
    let opts: CliOptions = parse_cli_options(t1_args);
    if opts.preset_name != "sunset" {
        return false;
    }

    let c_red: RgbColor = parse_hex_color("#ff0000");
    let c_blue: RgbColor = parse_hex_color("#0000ff");
    let mid_color: RgbColor = interpolate_two_colors(c_red, c_blue, 1, 3);
    if mid_color.r == 0 || mid_color.b == 0 {
        return false;
    }

    let p: GradientPreset = find_preset_by_name("fire");
    if p.name != "fire" {
        return false;
    }

    let span: GradientSpan = build_horizontal_span("Hello openOODA", p.stops);
    if list_len(span.colors) != chars_len("Hello openOODA") {
        return false;
    }

    let rendered: String = render_gradient_span(span, false);
    if rendered != "Hello openOODA" {
        return false;
    }

    return true;
}

pub fn main(
    fr: &FsReadCap,
    _pr: &ProcessCap,
    _env: &EnvCap,
    args: List[String]
) -> Int {
    let opts: CliOptions = parse_cli_options(args);

    if opts.show_help {
        print(render_cli_help());
        return 0;
    }
    if opts.show_version {
        print(render_cli_version());
        return 0;
    }
    if opts.run_test {
        if run_all_tests() {
            print("oogradient: internal anchor tests PASSED\n");
            return 0;
        } else {
            print("oogradient: internal anchor tests FAILED\n");
            return 1;
        }
    }
    if opts.show_mcp {
        return run_mcp_server(fr);
    }
    if opts.show_demo {
        print(render_gradient_demo(opts.use_color));
        return 0;
    }
    if opts.show_presets {
        let presets: List[GradientPreset] = get_standard_presets();
        if opts.json_output {
            print(presets_to_json(presets) + "\n");
        } else {
            let n: Int = list_len(presets);
            let mut i: Int = 0;
            while i < n {
                let p: GradientPreset = list_get(presets, i);
                let bar: String = render_color_bar(p.stops, 24, opts.use_color);
                print("  " + p.name + " (" + p.description + ")\n    Ramp: " + bar + "\n");
                i = i + 1;
            }
        }
        return 0;
    }

    let mut input_text: String = opts.text;
    if chars_len(input_text) == 0 {
        input_text = "openOODA Sovereign TrueColor Gradient Interpolation";
    }

    let mut stops: List[RgbColor] = list_new();
    if chars_len(opts.from_color) > 0 && chars_len(opts.to_color) > 0 {
        stops = list_push(stops, parse_hex_color(opts.from_color));
        stops = list_push(stops, parse_hex_color(opts.to_color));
    } else if chars_len(opts.preset_name) > 0 {
        let p: GradientPreset = find_preset_by_name(opts.preset_name);
        stops = p.stops;
    } else {
        let p: GradientPreset = find_preset_by_name("rainbow");
        stops = p.stops;
    }

    let span: GradientSpan = build_horizontal_span(input_text, stops);

    if opts.json_output {
        print(span_to_json(span) + "\n");
        return 0;
    }

    print(render_gradient_span(span, opts.use_color) + "\n");
    return 0;
}
