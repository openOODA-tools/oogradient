// # oogradient Root Subsystem Anchor
//
// Logline: Consolidates and re-exports core, render, and ipc subsystem anchors for oogradient.
//
// Setup: Root orchestration module ensuring complete architectural integrity.
//
// Beats:
//   1. Re-export core gradient color types and interpolation engine.
//   2. Re-export render formatters for ANSI TrueColor and JSON telemetry.
//   3. Re-export IPC options parser and streaming MCP server.
//   4. Validate cross-subsystem integration through comprehensive verification check.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_root_subsystem() -> Bool {
    let core_ok: Bool = verify_core_subsystem();
    if !core_ok {
        return false;
    }

    let render_ok: Bool = verify_render_subsystem();
    if !render_ok {
        return false;
    }

    let ipc_ok: Bool = verify_ipc_subsystem();
    if !ipc_ok {
        return false;
    }

    return true;
}
