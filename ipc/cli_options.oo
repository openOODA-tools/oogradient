// # Command-Line Options Parser
//
// Logline: Decodes CLI flags, palette presets, custom hex color bounds, and display modes for oogradient.
//
// Setup: Pure argument tokenizer supporting presets, two-color ranges, JSON, and MCP stdio switches.
//
// Beats:
//   1. Define structured CliOptions configuration type.
//   2. Parse help, version, preset, and custom hex color switches.
//   3. Parse JSON metrics, demo showcase, and ANSI color overrides.
//   4. Format standardized usage documentation and version text banners.

pub type CliOptions = struct {
    show_help: Bool,
    show_version: Bool,
    show_mcp: Bool,
    show_demo: Bool,
    show_presets: Bool,
    json_output: Bool,
    use_color: Bool,
    run_test: Bool,
    preset_name: String,
    from_color: String,
    to_color: String,
    text: String
};

pub fn render_cli_help() -> String {
    return "oogradient 0.2.0 (openOODA sovereign gradient & color styling)\n"
        + "usage: oogradient [options] [<text>...]\n\n"
        + "Applies smooth TrueColor color gradient interpolation across lines of text.\n\n"
        + "Options:\n"
        + "  -h, --help               display this help and exit\n"
        + "  -v, --version            output version information and exit\n"
        + "  -p, --preset <NAME>      select gradient preset (rainbow, sunset, cyberpunk, neon, aurora, plasma, ocean, fire)\n"
        + "      --from <HEX>         custom starting RGB color (e.g. #ff007f or 0x00ffff)\n"
        + "      --to <HEX>           custom ending RGB color (e.g. #00ffff)\n"
        + "      --presets            list all registered gradient presets\n"
        + "  -j, --json               output structured JSON metrics\n"
        + "  -D, --demo               interactive TrueColor gradient showcase\n"
        + "      --no-color           suppress ANSI escape codes\n"
        + "      --test               execute internal multi-tier verification suite\n"
        + "      --mcp                run as Model Context Protocol stdio server\n";
}

pub fn render_cli_version() -> String {
    return "oogradient 0.2.0 (openOODA sovereign userland)\n";
}

pub fn parse_cli_options(args: List[String]) -> CliOptions {
    let mut help_flag: Bool = false;
    let mut ver_flag: Bool = false;
    let mut mcp_flag: Bool = false;
    let mut demo_flag: Bool = false;
    let mut presets_flag: Bool = false;
    let mut json_flag: Bool = false;
    let mut color_flag: Bool = true;
    let mut test_flag: Bool = false;
    let mut p_name: String = "";
    let mut f_col: String = "";
    let mut t_col: String = "";
    let mut text_buf: String = "";

    let n: Int = list_len(args);
    let mut i: Int = 0;

    while i < n {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            help_flag = true;
        } else if arg == "-v" || arg == "--version" {
            ver_flag = true;
        } else if arg == "--mcp" {
            mcp_flag = true;
        } else if arg == "-D" || arg == "--demo" {
            demo_flag = true;
        } else if arg == "--presets" {
            presets_flag = true;
        } else if arg == "-j" || arg == "--json" {
            json_flag = true;
        } else if arg == "--no-color" {
            color_flag = false;
        } else if arg == "--test" {
            test_flag = true;
        } else if (arg == "-p" || arg == "--preset") && i + 1 < n {
            p_name = list_get(args, i + 1);
            i = i + 1;
        } else if arg == "--from" && i + 1 < n {
            f_col = list_get(args, i + 1);
            i = i + 1;
        } else if arg == "--to" && i + 1 < n {
            t_col = list_get(args, i + 1);
            i = i + 1;
        } else if !str_starts_with(arg, "-") {
            if chars_len(text_buf) == 0 {
                text_buf = arg;
            } else {
                text_buf = text_buf + " " + arg;
            }
        }
        i = i + 1;
    }

    return CliOptions {
        show_help: help_flag,
        show_version: ver_flag,
        show_mcp: mcp_flag,
        show_demo: demo_flag,
        show_presets: presets_flag,
        json_output: json_flag,
        use_color: color_flag,
        run_test: test_flag,
        preset_name: p_name,
        from_color: f_col,
        to_color: t_col,
        text: text_buf
    };
}
